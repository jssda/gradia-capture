#: src/ocr/engine.js:20
msgid "The Gradia app is not installed. Select another OCR engine in Settings → OCR & Translation."
msgstr "未安装 Gradia 应用, 请在「设置 → OCR 与翻译」中选择其他 OCR 引擎."

#: src/ocr/engine.js:21
msgid "LLM OCR is disabled. Enable it in Settings → OCR & Translation."
msgstr "LLM OCR 未启用, 请在「设置 → OCR 与翻译」中开启."

#: src/ocr/engine.js:22
msgid "OCR backend is not configured: fill in the base URL and model in Settings → OCR & Translation."
msgstr "OCR 后端未配置: 请在「设置 → OCR 与翻译」中填写 Base URL 和模型名称."

#: src/ocr/engine.js:23
msgid "Cannot read the API key file. Check its path and permissions."
msgstr "无法读取 API key 文件, 请检查路径和权限."

#: src/ocr/engine.js:24
msgid "The extra body is not valid JSON. Fix it in Settings → OCR & Translation."
msgstr "附加请求体不是合法 JSON, 请在「设置 → OCR 与翻译」中修正."

#: src/ocr/engine.js:25
msgid "The model output was truncated. Disable thinking mode in the extra body ({\"thinking\": {\"type\": \"disabled\"}}) or raise max_tokens."
msgstr "模型输出被截断: 可在附加请求体中关闭思考模式 ({\"thinking\": {\"type\": \"disabled\"}}) 或调高 max_tokens."

#: src/ocr/engine.js:26
msgid "The model returned no text. Check that the model supports image input."
msgstr "模型没有返回文本, 请确认所用模型支持图片输入."

#: src/ocr/engine.js:27
msgid "The model returned unexpected JSON. The original text is still available."
msgstr "模型返回了意外的 JSON 内容, 原文仍然可用."

#: src/ocr/engine.js:28
msgid "The OCR request timed out. Check the network and proxy settings."
msgstr "OCR 请求超时, 请检查网络和代理设置."

#: src/ocr/engine.js:29
msgid "The OCR service returned an HTTP error. Check the base URL, model name and API key."
msgstr "OCR 服务返回 HTTP 错误, 请检查 Base URL、模型名称和 API key."

#: src/ocr/engine.js:30
msgid "Cannot reach the OCR service. Check the base URL and network connection."
msgstr "无法连接 OCR 服务, 请检查 Base URL 和网络连接."

#: src/ocr/engine.js:31
msgid "The OCR service returned an invalid response."
msgstr "OCR 服务返回了无效响应."

#: src/ocr/engine.js:32
